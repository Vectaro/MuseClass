# Скопіюй у .env і заповни. Сам .env у git не комітиться.
# Згенерувати обидва значення:  openssl rand -base64 48

DB_PASSWORD=
JWT_SECRET=

# Пам'ять. Порожньо = розрахунок на мінімалку (Pi 4, 2 ГБ): 384m і 128MB.
#   4 ГБ (Pi 5 4GB):          API_HEAP=768m   PG_SHARED_BUFFERS=512MB
#   8 ГБ і більше, ПК, мініПК: API_HEAP=1g     PG_SHARED_BUFFERS=1GB
API_HEAP=
PG_SHARED_BUFFERS=
