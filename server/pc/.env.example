# Скопіюй у .env і заповни. Сам .env у git не комітиться.
# Згенерувати обидва значення (PowerShell) — див. README, «Запуск на Windows».

DB_PASSWORD=
JWT_SECRET=

# Пам'ять. Порожньо = за замовчуванням для ПК: 1g і 512MB (~2 ГБ у WSL).
#   Якщо ПК важко: API_HEAP=512m  PG_SHARED_BUFFERS=256MB
#   16 ГБ і більше: API_HEAP=1g    PG_SHARED_BUFFERS=1GB
API_HEAP=
PG_SHARED_BUFFERS=
