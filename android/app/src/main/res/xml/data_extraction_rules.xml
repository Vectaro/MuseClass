<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Токен входу не йде ні в хмару, ні на інший пристрій. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
