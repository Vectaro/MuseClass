<?xml version="1.0" encoding="utf-8"?>
<!-- .prow: назва партії (+ «твій»), опис; ⤓ — витягти партію -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_kv"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingTop="2dp"
    android:paddingRight="4dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/pmain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingLeft="6dp"
        android:paddingTop="9dp"
        android:paddingRight="6dp"
        android:paddingBottom="9dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pn"
                style="@style/Mc.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textSize="14sp" />

            <!-- .mine -->
            <TextView
                android:id="@+id/mine"
                style="@style/Mc.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_badge_amber"
                android:text="@string/v_yours"
                android:textColor="@color/on_accent"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/muted"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/pull"
        style="@style/Mc.IconButton"
        android:layout_marginStart="8dp"
        android:contentDescription="@string/v_pull"
        android:text="⤓" />
</LinearLayout>
